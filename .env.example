# Copy to .env. Production (ENV=prod) refuses to start with unsafe defaults.
ENV=dev
DATABASE_URL=sqlite:///./roastmyfeed.db
APP_SECRET=change-me-to-32+-random-characters
# Fernet keys, comma separated; first encrypts, all decrypt (key rotation).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
PROVIDER=auto            # auto (default) | sarvam | gemini | fake. auto uses a real model whenever a key below is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=         # setting this alone is enough with PROVIDER=auto
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_JSON_MODE=false
# Pricing used only for cost ESTIMATES (USD per million tokens). Set from your current price sheet.
PRICING_VERSION=unset
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
EMBEDDED_WORKER=true     # dev only; run `python -m app.worker` separately in production
SUPPORT_CONTACT=support@your-domain.example
METRICS_TOKEN=
# Kill switches (deletion is never gated)
GENERATION_ENABLED=true
REGENERATION_ENABLED=true
DISABLED_PROVIDERS=
DISABLED_PROMPT_VERSIONS=
YOUTUBE_CONNECT_ENABLED=false
